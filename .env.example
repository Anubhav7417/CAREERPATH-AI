# CareerPath AI - Local Environment Configuration
# Copy this file to .env and replace placeholders with actual values.

# Google Gemini API Key from Google AI Studio
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Turso Cloud Database Configuration
# Obtain credentials from your Turso dashboard (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_auth_jwt_token_here

